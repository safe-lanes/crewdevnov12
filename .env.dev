# -----------------------------------------------
# Platform-provided (do not set in .env)
# -----------------------------------------------
# CI         — set automatically by CI runners; consumed by playwright.config.ts.
# REPL_ID    — set automatically by Replit; consumed by vite.config.ts.
# import.meta.env.DEV / import.meta.env.PROD — Vite built-ins derived from
#              the build mode; not configurable via .env.
