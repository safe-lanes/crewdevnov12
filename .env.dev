# SAIL Crewing - Environment Variables
# Copy this file as .env on your production server.
# Every variable the application code reads is listed below, grouped by area.
# Variables with code-side defaults are documented with their default value.

##%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# ===============================================
# Production environment
# ===============================================

# -----------------------------------------------
# Server / runtime
# -----------------------------------------------
NODE_ENV="production"
PORT="4000"
# Express session secret (cookie signing).
SESSION_SECRET="your-super-secret-session-key-here"

# -----------------------------------------------
# Database
# -----------------------------------------------
# Per-tenant DB connection string. Leave commented when using the master DB
# + tenant connection manager (recommended) — it will be derived per request.
# DATABASE_URL="postgres://postgres:sailadmin@localhost:5432/crew_management"
# Master DB used by tenantConnectionManager to look up tenant DB URLs.
MASTER_DATABASE_URL="postgres://postgres:sailadmin@localhost:5432/sails_master_crewing"

# -----------------------------------------------
# Auth / JWT
# -----------------------------------------------
# Access-token signing secret.
JWT_SECRET="12345678901234567890"
# Refresh-token signing secret. REQUIRED in production. Must be different
# from JWT_SECRET — server/v2/auth/tokens.ts refuses to boot otherwise.
JWT_REFRESH_SECRET="change-me-refresh-secret-must-differ-from-access"
# Token TTLs (zeit/ms format, e.g. "15m", "7d", "1h"). Defaults shown.
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PASSWORD_RESET_TTL="1h"
# Bcrypt cost factor for password hashing. Default 12.
BCRYPT_ROUNDS="12"
# Account lockout policy used by server/v2/auth/routes.ts.
AUTH_MAX_FAILED="5"
AUTH_LOCKOUT_MIN="15"
AUTH_LOCKOUT_MAX_MIN="1440"
# Dev-only bypass flags. Ignored unless NODE_ENV=development.
## AUTH_BYPASS="true"
## VITE_AUTH_BYPASS="true"
# Tenant domain used as a fallback when AUTH_BYPASS=true and the request
# carries no JWT. Default "dev.local".
# DEV_DOMAIN="dev.local"

# -----------------------------------------------
# Tenant connection pooling
# -----------------------------------------------
# Max connections kept open per tenant pool. Default 5.
TENANT_POOL_MAX="5"
# Hard cap across all tenant pools combined. Default 80.
GLOBAL_MAX_CONNECTIONS="80"

# -----------------------------------------------
# Frontend (Vite — must be prefixed with VITE_)
# -----------------------------------------------
VITE_API_BASE_URL="https://dev.sl-sail.com/b/api/v1"
VITE_CLIENT_ENCRYPTION_KEY="sailAdmin"
# Auth mode: "standalone" (this app handles login) or "parent"
# (delegate to a parent app via VITE_PARENT_LOGIN_URL). Default "standalone".
VITE_AUTH_MODE="standalone"
VITE_PARENT_LOGIN_URL="https://dev.sl-sail.com/login"
## AG Grid Enterprise License (optional)
AG_GRID_LICENSE_KEY=Using_this_{AG_Charts_and_AG_Grid}_Enterprise_key_{AG-090368}_in_excess_of_the_licence_granted_is_not_permitted___Please_report_misuse_to_legal@ag-grid.com___For_help_with_changing_this_key_please_contact_info@ag-grid.com___{Safe_Lanes_Consultants_Pte_Ltd}_is_granted_a_{Single_Application}_Developer_License_for_the_application_{SAIL}_only_for_{1}_Front-End_JavaScript_developer___All_Front-End_JavaScript_developers_working_on_{SAIL}_need_to_be_licensed___{SAIL}_has_been_granted_a_Deployment_License_Add-on_for_{1}_Production_Environment___This_key_works_with_{AG_Charts_and_AG_Grid}_Enterprise_versions_released_before_{23_September_2025}____[v3]_[0102]_MTc1ODU4MjAwMDAwMA==461929539170ec991c51dbb3cb8da123
VITE_AG_GRID_LICENSE_KEY=Using_this_{AG_Charts_and_AG_Grid}_Enterprise_key_{AG-090368}_in_excess_of_the_licence_granted_is_not_permitted___Please_report_misuse_to_legal@ag-grid.com___For_help_with_changing_this_key_please_contact_info@ag-grid.com___{Safe_Lanes_Consultants_Pte_Ltd}_is_granted_a_{Single_Application}_Developer_License_for_the_application_{SAIL}_only_for_{1}_Front-End_JavaScript_developer___All_Front-End_JavaScript_developers_working_on_{SAIL}_need_to_be_licensed___{SAIL}_has_been_granted_a_Deployment_License_Add-on_for_{1}_Production_Environment___This_key_works_with_{AG_Charts_and_AG_Grid}_Enterprise_versions_released_before_{23_September_2025}____[v3]_[0102]_MTc1ODU4MjAwMDAwMA==461929539170ec991c51dbb3cb8da123

# -----------------------------------------------
# Seed script (scripts/seed-auth-admin.ts)
# Only consumed when running the admin seeder; safe to leave unset otherwise.
# -----------------------------------------------
# USERNAME="admin"
# PASSWORD=""           # required at run time, no default
# DOMAIN="rsms"
# EMAIL=""              # default: <username>@<domain>.local
# FULL_NAME="Administrator"

##%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%



