# SAIL Crewing - Production Environment Variables
# Copy this file as .env on your production server

# ===============================================
# Session Configuration
# ===============================================
SESSION_SECRET="your-super-secret-session-key-here"

##%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# ===============================================
# Server Configuration for production
# ===============================================
NODE_ENV="production"
PORT="4000"
# DATABASE_URL="postgres://postgres:sailadmin@localhost:5432/crew_management"
MASTER_DATABASE_URL="postgres://postgres:sailadmin@localhost:5432/sails_master_crewing"
VITE_API_BASE_URL="https://dev.sl-sail.com/b/api/v1"
VITE_API_CREWING_URL="https://dev.sl-sail.com/crewing"
VITE_CLIENT_ENCRYPTION_KEY="sailAdmin"
## AUTH_BYPASS="true"
## VITE_AUTH_BYPASS="true"
JWT_SECRET="12345678901234567890"
VITE_PARENT_LOGIN_URL="https://dev.sl-sail.com/login"
ALERT_SCAN_INTERVAL_MS=900000
# ======= Email Service Configuration =======
# Local Gmail OAuth2 (primary)
# GMAIL_SUPPORT_EMAIL="support@sl-sail.com"
# EMAIL_CC=""
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""
# GMAIL_REFRESH_TOKEN=""
# ACCESS_TOKEN=""
EMAIL_API_URL="https://dev.sl-sail.com/socket/send-bulk-email"
VESSEL_API="2a13dd62abd50c4a8c926111f3e383fc9c429085d5e0feb716d842090286235a"
VESSEL_API_URL="https://api.vesselapi.com/v1/search/vessels"
SCREENING_PROVIDER=ofacApi
SCREENING_API_URL=https://api.ofac-api.com/v4/screen
SCREENING_API_KEY=b1f24ae0-f57a-453b-988a-62c06063dd98
IMPORT_TEMPLATE_MAX_ROWS=15000

