# SAIL Crewing - Production Environment Variables
# Copy this file as .env on your production server

# ===============================================
# Database Configuration
# ===============================================
DATABASE_URL="postgres://postgres:sailadmin@localhost:5432/crew_management_new"

# Multi-Tenant Master Database (contains tenants table mapping domain → tenant DB)
# When set, the app runs in multi-tenant mode: x-tenant-id header is REQUIRED on all V2 API routes
# When NOT set (e.g., Replit dev), the app uses DATABASE_URL directly (single-tenant mode)
MASTER_DATABASE_URL="postgres://postgres:sailadmin@localhost:5432/sails_master_crewing"

# ===============================================
# Server Configuration
# ===============================================
NODE_ENV="production"
PORT="4000"

# ===============================================
# Session Configuration
# ===============================================
SESSION_SECRET="your-super-secret-session-key-here"

# ===============================================
# Frontend Configuration (used during build)
# ===============================================
VITE_API_BASE_URL="https://dev.sl-sail.com/b/api/v1"
VITE_CLIENT_ENCRYPTION_KEY="sailAdmin"
VITE_PARENT_LOGIN_URL="https://dev.sl-sail.com/login"

# AG Grid Enterprise License (optional)
# VITE_AG_GRID_LICENSE_KEY="your-ag-grid-license-key"
