# SAIL Crewing - Production Environment Variables
# Copy this file as .env on your production server

# ===============================================
# Session Configuration
# ===============================================
SESSION_SECRET="your-super-secret-session-key-here"

##%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

# ==================================================================================================
# SAIL CREW MOBILE / BFF — COMPLETE EXAMPLE VARIABLE BLOCK
# ==================================================================================================
# Examples only: copy the required entries into active (uncommented) development configuration and
# replace every replace_with_* value. Never reuse these examples in production and never commit real
# passwords, tokens, MFA keys, database credentials, signing credentials, or reviewer credentials.
# EXPO_PUBLIC_* values are embedded in the mobile client and MUST NOT contain secrets.

# --- Shared runtime and tenant database ----------------------------------------------------------------
# NODE_ENV=development
# PORT=5000
# DATABASE_URL=postgresql://crew_app_user:replace_with_password@127.0.0.1:5432/sail_tenant_dev
# MASTER_DATABASE_URL=postgresql://crew_master_user:replace_with_password@127.0.0.1:5432/sails_master_crewing
# CREW_APP_TENANCY_MODE=multi
# CREW_APP_SINGLE_TENANT_DOMAIN=dev.example.invalid

# --- Crew mobile authentication and session security ---------------------------------------------------
# Generate separate random values of at least 32 characters. Do not reuse JWT_SECRET or any value below.
# CREW_APP_ACCESS_TOKEN_SECRET=replace_with_unique_random_access_token_secret
# CREW_APP_REFRESH_TOKEN_SECRET=replace_with_unique_random_refresh_token_secret
# CREW_APP_ACCESS_TOKEN_TTL=15m
# CREW_APP_ALLOWED_ORIGINS=https://crew-dev.example.invalid,http://localhost:8081
# CREW_APP_ALLOW_TEST_PROVISIONING=false

# --- TOTP MFA -------------------------------------------------------------------------------------------
# Exactly 32 random bytes encoded as 64 hexadecimal characters or standard base64.
# Example generation: openssl rand -hex 32
# CREW_APP_MFA_ENCRYPTION_KEY=replace_with_64_hex_characters_from_a_secret_manager

# --- Notifications --------------------------------------------------------------------------------------
# CREW_APP_NOTIFICATION_EXPIRY_DAYS=60
# CREW_APP_NOTIFICATION_SCAN_INTERVAL_MS=3600000

# --- Malware scanner (ClamAV) ---------------------------------------------------------------------------
# Production requires "clamav"; use only an explicitly approved development scanner configuration.
# CREW_APP_FILE_SCANNER=clamav
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000

# --- Private attachment object storage ------------------------------------------------------------------
# Production requires "s3". ATTACHMENT_S3_ENDPOINT is normally omitted for AWS and set for MinIO/dev.
# ATTACHMENT_STORAGE_DRIVER=s3
# ATTACHMENT_S3_BUCKET=sail-crew-dev-private
# ATTACHMENT_S3_REGION=ap-south-1
# ATTACHMENT_S3_ENDPOINT=https://minio-dev.example.invalid
# ATTACHMENT_S3_FORCE_PATH_STYLE=true
# ATTACHMENT_S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/replace_with_key_id
# Prefer workload identity/instance roles. Static keys below are development examples only.
# ATTACHMENT_S3_ACCESS_KEY_ID=replace_with_dev_access_key
# ATTACHMENT_S3_SECRET_ACCESS_KEY=replace_with_dev_secret_key

# --- Security events and SIEM ---------------------------------------------------------------------------
# CREW_APP_SECURITY_EVENT_KEY=replace_with_unique_random_event_pseudonymization_key
# CREW_APP_SIEM_URL=https://siem-dev.example.invalid/api/events
# CREW_APP_SIEM_TOKEN=replace_with_dev_siem_ingestion_token

# --- Durable ERP command worker -------------------------------------------------------------------------
# ERP_COMMAND_WORKER_ENABLED=false
# ERP_COMMAND_WORKER_POLL_INTERVAL_MS=5000
# ERP_COMMAND_WORKER_BATCH_SIZE=10
# ERP_COMMAND_WORKER_CONCURRENCY=2
# ERP_COMMAND_LEASE_SECONDS=60
# ERP_COMMAND_MAX_ATTEMPTS=5

# --- Expo/mobile public build configuration -------------------------------------------------------------
# These values are public. EXPO_PROJECT_ID is created by `eas init`; use the organization project UUID.
# EXPO_PUBLIC_API_BASE_URL=https://crew-api-dev.example.invalid
# EXPO_PUBLIC_API_BASE_URL_WEB=https://crew-api-dev.example.invalid
# EXPO_PROJECT_ID=12345678-1234-1234-1234-123456789abc

# --- Authorized maritime/offline test harness -----------------------------------------------------------
# Never commit a real access token. Run only against an explicitly authorized non-production target.
# PERF_BASE_URL=https://crew-staging.example.invalid
# PERF_ACCESS_TOKEN=replace_at_runtime_only
# PERF_SCENARIO=latency-500ms
# PERF_ITERATIONS=5
# PERF_CONCURRENCY=1
# PERF_TIMEOUT_MS=45000
# PERF_NON_PRODUCTION_ACK=I_ACKNOWLEDGE_NON_PRODUCTION
# PERF_OPERATION_UUID=replace_with_existing_test_operation_uuid
# PERF_ENABLE_MUTATIONS=false
# PERF_MUTATION_SECTION=personal
# PERF_MUTATION_PAYLOAD={"example":"synthetic-test-data-only"}

# ==================================================================================================
# END SAIL CREW MOBILE / BFF EXAMPLE VARIABLE BLOCK
# ==================================================================================================
# ===============================================
# Server Configuration for production
# ===============================================
NODE_ENV="production"
PORT="4000"
# DATABASE_URL="postgres://postgres:sailadmin@localhost:5432/crew_management"
MASTER_DATABASE_URL="postgres://postgres:sailadmin@localhost:5432/sails_master_crewing"
VITE_API_BASE_URL="https://dev.sl-sail.com/b/api/v1"
VITE_API_CREWING_URL="https://dev.sl-sail.com/crewing"
VITE_CLIENT_ENCRYPTION_KEY="sailAdmin"
## AUTH_BYPASS="true"
## VITE_AUTH_BYPASS="true"
JWT_SECRET="12345678901234567890"
VITE_PARENT_LOGIN_URL="https://dev.sl-sail.com/login"
ALERT_SCAN_INTERVAL_MS=900000
# ======= Email Service Configuration =======
# Local Gmail OAuth2 (primary)
# GMAIL_SUPPORT_EMAIL="support@sl-sail.com"
# EMAIL_CC=""
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""
# GMAIL_REFRESH_TOKEN=""
# ACCESS_TOKEN=""
EMAIL_API_URL="https://dev.sl-sail.com/socket/send-bulk-email"
VESSEL_API="2a13dd62abd50c4a8c926111f3e383fc9c429085d5e0feb716d842090286235a"
VESSEL_API_URL="https://api.vesselapi.com/v1/search/vessels"
SCREENING_PROVIDER=ofacApi
SCREENING_API_URL=https://api.ofac-api.com/v4/screen
SCREENING_API_KEY=b1f24ae0-f57a-453b-988a-62c06063dd98
IMPORT_TEMPLATE_MAX_ROWS=15000

