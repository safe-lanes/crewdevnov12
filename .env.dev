CREW_APP_ACCESS_TOKEN_SECRET="12345678901234567890"
CREW_APP_REFRESH_TOKEN_SECRET="4Tk8Gp1Lx5Bv9Nf2Qj6Hd0Wm3Sr7Cy1Zo4Iu8Ea2Mb5Vp9Xn0Jq"  # must differ from CREW_APP_ACCESS_TOKEN_SECRET
CREW_APP_ACCESS_TOKEN_TTL="15m"
# Below were previously unset, relying on their code defaults (shown) — made
# explicit here, same effective values, nothing changes at runtime.
CREW_APP_TENANCY_MODE="auto"                 # auto|single|multi — auto picks multi since MASTER_DATABASE_URL is set above
# CREW_APP_SINGLE_TENANT_DOMAIN=""            # only used when CREW_APP_TENANCY_MODE resolves to "single"; not applicable in this multi-tenant config
CREW_APP_NOTIFICATION_EXPIRY_DAYS="30"       # visa/document expiry notifications fire within this many days of expiry
CREW_APP_NOTIFICATION_SCAN_INTERVAL_MS="900000"  # 15 min — background scanner interval
# CREW_APP_ALLOW_TEST_PROVISIONING deliberately not set here — it's a one-off
# safety gate for scripts/provisionTestCrew.ts, meant to be passed inline on
# the command that needs it, not left standing in a checked-in-adjacent file.


