# Copy this file to .env and fill in your values. .env is gitignored — never commit real values.

# The crew-app backend's origin. Required — the app throws at startup without it.
# - Web preview (npx expo start --web): defaults to http://localhost:5001 if unset.
# - Native device/simulator: must be a reachable LAN URL (not localhost, unless your
#   simulator/emulator has port forwarding configured) — e.g. http://192.168.1.100:5000
# - Production/release builds: MUST be https:// — enforced at startup (throws
#   otherwise) whenever __DEV__ is false, so a misconfigured production build can't
#   silently ship credentials over plaintext HTTP.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000

# Optional. Local web preview only (npx expo start --web) — takes priority over
# EXPO_PUBLIC_API_BASE_URL when Platform.OS === "web", so native and web can
# point at different backends at the same time. Native ignores this var.
# Defaults to http://localhost:5000 if unset.
EXPO_PUBLIC_API_BASE_URL_WEB=http://localhost:5000
